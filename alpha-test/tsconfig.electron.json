{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["electron/**/*", "database/**/*"],
  "exclude": ["node_modules", "dist", "release"]
}
